# GITHUB_TOKEN=
# PAT with access to the configured Unreal Engine GitHub repo
# (default EpicGames/UnrealEngine; use repo scope for a private fork)
# GH_TOKEN=   # accepted as an alias

# Optional overrides (public defaults shown)
# UE_OWNER=EpicGames
# UE_REPO=UnrealEngine
# UE_REF=release
# Private fork: set UE_OWNER / UE_REPO / UE_REF to your GitHub fork.
# UE_FIXTURE=1

# Web Remote Control HTTP (enable Remote Control API, then WebControl.StartServer).
# Default http://127.0.0.1:30010. Override for a remote lab host (bind + firewall).
# Other Unreal services (for example Zen) on other ports are not Remote Control.
# UE_REMOTE_CONTROL_URL=http://127.0.0.1:30010

# Cursor Marketplace Configure declares the same names in .cursor-plugin/plugin.json.
# Never commit secrets.
